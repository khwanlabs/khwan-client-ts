{
  "name": "@khwan/client",
  "version": "0.1.0",
  "description": "Thin TypeScript client for the Khwan hosted cognition layer (memory + identity + learning). BYOM: prepare context, call your own model, record the result.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "khwan",
    "ai",
    "memory",
    "agents",
    "cognition",
    "llm",
    "byom"
  ],
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.5.0"
  }
}
